# NOTE:
# This git repository is rooted at Desktop. We intentionally version-control ONLY
# the PhasonFold project directory and a small set of repo metadata files.
# Everything else on Desktop is ignored to avoid accidentally committing
# personal files and large binaries.

# Ignore everything by default
/*

# Keep repo metadata
!.gitignore
!README.md

# Track ONLY the project directory
!Omega-Protein-Folding/
!Omega-Protein-Folding/**

# Never commit editor/agent state
Omega-Protein-Folding/.cursor/
Omega-Protein-Folding/.cursor/**
Omega-Protein-Folding/**/.cursor/
Omega-Protein-Folding/**/.cursor/**

# Common local environments / caches
Omega-Protein-Folding/.venv/
Omega-Protein-Folding/.venv/**
Omega-Protein-Folding/**/__pycache__/
Omega-Protein-Folding/**/*.pyc

# LaTeX build artifacts
Omega-Protein-Folding/paper/**/*.aux
Omega-Protein-Folding/paper/**/*.bbl
Omega-Protein-Folding/paper/**/*.blg
Omega-Protein-Folding/paper/**/*.fdb_latexmk
Omega-Protein-Folding/paper/**/*.fls
Omega-Protein-Folding/paper/**/*.log
Omega-Protein-Folding/paper/**/*.out
Omega-Protein-Folding/paper/**/*.pdf
Omega-Protein-Folding/paper/**/*.synctex.gz

# Local "evidence outputs" (keep out of git by default)
# These folders are large and are often generated/downloaded locally.
Omega-Protein-Folding/data/
Omega-Protein-Folding/artifacts/
Omega-Protein-Folding/figures/

